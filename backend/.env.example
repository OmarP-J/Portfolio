# Copy this file to .env and fill in the values.
# Never commit .env or real passwords.

# API Configuration
API_TITLE=Portfolio API
API_VERSION=1.0.0
API_DESCRIPTION=Professional Portfolio Backend API

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False

# CORS Configuration
CORS_ORIGINS=*

# Contact form email
# Option 1 (recommended): Resend API key from https://resend.com/api-keys
RESEND_API_KEY=
CONTACT_EMAIL_TO=you@example.com

# Option 2: SMTP (only used when RESEND_API_KEY is empty)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
